generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  loans     Loan[]
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  isbn        String   @unique
  totalCopies Int
  available   Int
  category    String?
  createdAt   DateTime @default(now())
  loans       Loan[]
}

model Loan {
  id          Int       @id @default(autoincrement())
  userId      Int
  bookId      Int
  status      LoanStatus @default(BORROWED)
  borrowedAt  DateTime   @default(now())
  returnedAt  DateTime?
  user        User       @relation(fields: [userId], references: [id])
  book        Book       @relation(fields: [bookId], references: [id])
}

enum Role {
  ADMIN
  BIBLIOTECARIO
  USER
}

enum LoanStatus {
  BORROWED
  RETURNED
}
