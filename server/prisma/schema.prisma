generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  loans     Loan[]
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  isbn        String   @unique
  totalCopies Int
  available   Int
  createdAt   DateTime @default(now())
  loans       Loan[]
}

model Loan {
  id         Int      @id @default(autoincrement())
  userId     Int
  bookId     Int
  loanDate   DateTime @default(now())
  returnDate DateTime?
  status     LoanStatus @default(BORROWED)

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])
}

enum Role {
  ADMIN
  BIBLIOTECARIO
  USER
}

enum LoanStatus {
  BORROWED
  RETURNED
}
